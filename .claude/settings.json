{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf /Users/*)",
      "Bash(rm -rf /home/*)",
      "Bash(rm -rf /Library/*)",
      "Bash(rm -rf /System/*)",
      "Bash(rm -rf /Applications/*)",
      "Bash(rm -rf /etc/*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout --*)"
