      "Bash(./scripts/build-docs.sh *)",
      "Bash(./scripts/build-gerbers.sh *)",
      "Bash(./tools/coverage.sh *)",
      "Bash(./tools/decode_coredump.sh *)",
      "Bash(./tools/build_user_pdfs.sh *)",
      "Bash(python3 tools/*)",
      "Bash(node --check *)",
      "Bash(node minify.js*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git tag*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git rev-list*)",
      "Bash(git rev-parse*)",
      "Bash(git check-ignore*)",
      "Bash(git show-ref*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh auth status*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(diff *)",
      "Bash(du *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(test *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(tr *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(xargs *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(unzip -l*)",
      "Bash(zip *)",
      "Bash(nm *)"
    ]
