(version 1)
# Isolement entre les trois domaines de la carte de mesure.
# 5,0 mm et non 5,5 : la limite est fixee par les plots de l ADM3260 (SSOP-20), dont les
# deux rangees sont a 5,1 mm bord a bord. Les bandes interdites, elles, font 5,5 mm.
# ATTENTION : cette regle compare des cuivres d'une MEME couche. Le recouvrement entre
# couches differentes est empeche par les zones interdites, pas par cette regle.
(rule "Isolement ESP32 / voie pH"
  (condition "A.NetClass == 'PRIMAIRE' && B.NetClass == 'ISO_PH'")
  (constraint clearance (min 5.0mm)))
(rule "Isolement ESP32 / voie ORP"
  (condition "A.NetClass == 'PRIMAIRE' && B.NetClass == 'ISO_ORP'")
  (constraint clearance (min 5.0mm)))
(rule "Isolement voie pH / voie ORP"
  (condition "A.NetClass == 'ISO_PH' && B.NetClass == 'ISO_ORP'")
  (constraint clearance (min 5.0mm)))
