+static void logMbedtlsOfflineChainBisection() {
+  systemLogger.info("[bug-165] Debut bissection hors ligne (chaine reelle GitHub du 2026-10-14)");
+
+  mbedtls_x509_crt trust;
+  mbedtls_x509_crt_init(&trust);
+  int trustRet = mbedtls_x509_crt_parse(&trust, (const unsigned char*)GITHUB_ROOT_CA, strlen(GITHUB_ROOT_CA) + 1);
+  if (trustRet < 0) {
+    systemLogger.error("[bug-165] Echec parsing GITHUB_ROOT_CA pour bissection (code=" + String(trustRet) + ")");
+    mbedtls_x509_crt_free(&trust);
+    return;
+  }
+
+  // A. Chaîne COMPLETE (leaf + E36 + E46 croisée) contre les 5 ancres
+  {
+    mbedtls_x509_crt chain;
+    mbedtls_x509_crt_init(&chain);
+    mbedtls_x509_crt_parse(&chain, (const unsigned char*)kBug165Leaf, strlen(kBug165Leaf) + 1);
+    mbedtls_x509_crt_parse(&chain, (const unsigned char*)kBug165E36, strlen(kBug165E36) + 1);
+    mbedtls_x509_crt_parse(&chain, (const unsigned char*)kBug165E46Crossed, strlen(kBug165E46Crossed) + 1);
+    bug165VerifyAndLog("A) chaine complete (leaf+E36+E46-croisee) vs 5 ancres", &chain, &trust);
+    mbedtls_x509_crt_free(&chain);
