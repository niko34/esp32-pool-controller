+// bug-165 : instrumentation TLS — accès bas niveau à mbedtls pour capturer la
+// chaîne de certificats REÇUE et le résultat de vérification DÉTAILLÉ avant
+// que NetworkClientSecure::connect() ne libère le contexte (mbedtls_ssl_free)
+// sur échec. Observation uniquement, aucune modification du comportement TLS.
+#include "ssl_client.h"
+#include <mbedtls/x509_crt.h>
+// bug-165 (suite) : trancher l'hypothèse ECDSA P-384/SHA-384 — observation
+// pure à l'EXÉCUTION (la config sdkconfig est une déclaration de build, pas
+// une garantie du binaire précompilé livré par pioarduino).
+#include <mbedtls/ecp.h>
+#include <mbedtls/version.h>
+// bug-165 (suite, live) : callback mbedtls_ssl_conf_verify() posé DEPUIS le
+// code du projet — ssl_client.cpp (framework) contient l'appel mais
+// COMMENTÉ ; on ne le modifie pas, on pose notre propre callback sur
+// sslclient->ssl_conf après start_ssl_client() (voir OtaDiagnosticSecureClient).
+#include <mbedtls/pk.h>
+#include <mbedtls/oid.h>
+
+// Contexte passé au callback — compteur simple, aucune allocation.
+struct Bug165LiveChainContext {
+  int certCount = 0;
+};
+
+// Appelé par mbedtls PENDANT le handshake réel, une fois par certificat de la
+// chaîne examinée (profondeur croissante depuis le pair, 0 = feuille).
+// ⚠️ Observation PURE : ne modifie jamais *flags, renvoie toujours 0 — le
+// handshake doit échouer exactement comme en production.
+static int bug165LiveVerifyCallback(void* data, mbedtls_x509_crt* crt, int depth, uint32_t* flags) {
+  Bug165LiveChainContext* ctx = static_cast<Bug165LiveChainContext*>(data);
+  ctx->certCount++;
+
+  char subjBuf[150] = {0};
+  char issBuf[150] = {0};
+  mbedtls_x509_dn_gets(subjBuf, sizeof(subjBuf), &crt->subject);
+  mbedtls_x509_dn_gets(issBuf, sizeof(issBuf), &crt->issuer);
+
+  const char* sigDesc = "?";
+  mbedtls_oid_get_sig_alg_desc(&crt->sig_oid, &sigDesc);
+
+  const char* curveName = "(non-EC ou indisponible)";
+  mbedtls_pk_type_t pkType = mbedtls_pk_get_type(&crt->pk);
+  if (pkType == MBEDTLS_PK_ECKEY || pkType == MBEDTLS_PK_ECKEY_DH || pkType == MBEDTLS_PK_ECDSA) {
+    mbedtls_ecp_keypair* ec = mbedtls_pk_ec(crt->pk);
+    if (ec != nullptr) {
+      mbedtls_ecp_group_id gid = mbedtls_ecp_keypair_get_group_id(ec);
+      const mbedtls_ecp_curve_info* ci = mbedtls_ecp_curve_info_from_grp_id(gid);
+      if (ci != nullptr) {
+        curveName = ci->name;
+      }
+    }
+  }
+
+  systemLogger.error(
+    String("[bug-165] LIVE depth=") + String(depth) +
+    " sujet=[" + String(subjBuf) + "] emetteur=[" + String(issBuf) + "]" +
+    " flags_a_ce_niveau=0x" + String(*flags, HEX) +
+    " sig=[" + String(sigDesc) + "] courbe=[" + String(curveName) + "]");
+
+  return 0;  // ne jamais forcer/corriger : observer seulement
+}
