+// bug-165 : sous-classe diagnostique. Ré-implémente le SEUL point d'entrée
+// virtuel réellement appelé par HTTPClient::connect()
+// (NetworkClient::connect(host, port, timeout)) pour intercepter le résultat
+// du handshake AVANT le stop() qui efface ssl_ctx. Le comportement final
+// (stop() sur échec, _connected=true sur succès) est identique à
+// NetworkClientSecure::connect() — seule une capture de diagnostic est
+// insérée entre les deux.
+class OtaDiagnosticSecureClient : public WiFiClientSecure {
+ public:
+  int diagVerifyFlags = -1;              // masque mbedtls_ssl_get_verify_result()
+  char diagVerifyInfo[256] = {0};        // mbedtls_x509_crt_verify_info() en clair
+  int diagCaAnchorCount = -1;            // ancres chargées depuis GITHUB_ROOT_CA
+  int diagPeerCertCount = 0;             // profondeur de la chaîne REÇUE
+  String diagPeerChainSummary;           // sujet/émetteur par certificat reçu
+  // bug-165 (suite) : profil de vérification RÉELLEMENT configuré par
+  // start_ssl_client() (mbedtls_ssl_config_defaults) — lu, jamais supposé.
+  // `cert_profile` est un champ mbedtls MBEDTLS_PRIVATE ; sans définir
+  // MBEDTLS_ALLOW_PRIVATE_ACCESS, le nom réel du champ est `private_cert_profile`
+  // (voir mbedtls/private_access.h) — accès direct, aucune modification du
+  // framework.
+  const mbedtls_x509_crt_profile* diagCertProfile = nullptr;
+
+  int connect(const char* host, uint16_t port, int32_t timeout) override {
+    _timeout = timeout;
+    IPAddress address;
+    if (!Network.hostByName(host, address)) {
+      return 0;
+    }
+    int ret = start_ssl_client(sslclient.get(), address, port, host, _timeout,
+                                _CA_cert, _use_ca_bundle, _cert, _private_key,
+                                nullptr, nullptr, _use_insecure, _alpn_protos);
+
+    // bug-165 (suite) : capturer le profil EXACT utilisé par CETTE connexion,
+    // avant toute hypothèse.
+    diagCertProfile = sslclient->ssl_conf.private_cert_profile;
+
+    // bug-165 (suite, live) : poser le callback APRÈS start_ssl_client (qui
+    // configure ssl_conf) et AVANT le handshake — seul point d'insertion
+    // possible depuis le projet.
+    Bug165LiveChainContext liveCtx;
+    if (ret >= 0) {
+      mbedtls_ssl_conf_verify(&sslclient->ssl_conf, bug165LiveVerifyCallback, &liveCtx);
+    }
+
+    if (ret >= 0 && !_stillinPlainStart) {
+      ret = ssl_starttls_handshake(sslclient.get());
+    }
+    sslclient->last_error = ret;
+    systemLogger.info("[bug-165] LIVE maillons vus par le callback pendant le handshake reel: " +
+                      String(liveCtx.certCount));
+    collectDiagnostics();
+    if (ret < 0) {
+      stop();
+      return 0;
+    }
+    _connected = true;
+    return 1;
+  }
+
+ private:
+  void collectDiagnostics() {
+    // Ancres CA chargées dans sslclient->ca_cert (chaîne liée mbedtls).
+    diagCaAnchorCount = 0;
+    const mbedtls_x509_crt* anchor = &sslclient->ca_cert;
+    while (anchor != nullptr && anchor->raw.p != nullptr) {
+      diagCaAnchorCount++;
+      anchor = anchor->next;
+    }
+
+    // Résultat de vérification DÉTAILLÉ (peut être 0/absent si le handshake
+    // n'a pas atteint l'étape de vérification du certificat pair).
+    diagVerifyFlags = static_cast<int>(mbedtls_ssl_get_verify_result(&sslclient->ssl_ctx));
+    if (diagVerifyFlags > 0) {
+      mbedtls_x509_crt_verify_info(diagVerifyInfo, sizeof(diagVerifyInfo), "  ! ", (uint32_t)diagVerifyFlags);
+    } else {
+      diagVerifyInfo[0] = '\0';
+    }
+
+    // Chaîne de certificats REÇUE du pair (sujet + émetteur par maillon).
+    diagPeerChainSummary = "";
+    diagPeerCertCount = 0;
+    const mbedtls_x509_crt* peer = mbedtls_ssl_get_peer_cert(&sslclient->ssl_ctx);
+    while (peer != nullptr) {
+      char subjBuf[150] = {0};
+      char issBuf[150] = {0};
+      mbedtls_x509_dn_gets(subjBuf, sizeof(subjBuf), &peer->subject);
+      mbedtls_x509_dn_gets(issBuf, sizeof(issBuf), &peer->issuer);
+      diagPeerChainSummary += "#" + String(diagPeerCertCount) + " sujet=[" + String(subjBuf) +
+                              "] emetteur=[" + String(issBuf) + "] ";
+      peer = peer->next;
+      diagPeerCertCount++;
+    }
+  }
+};
