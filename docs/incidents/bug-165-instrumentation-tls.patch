+static void bug165VerifyAndLog(const char* label, mbedtls_x509_crt* crt, mbedtls_x509_crt* trust) {
+  uint32_t flags = 0;
+  // cn=nullptr DÉLIBÉRÉMENT : on isole la confiance (chaîne de signatures),
+  // pas la correspondance de nom d'hôte — pour ne pas confondre NOT_TRUSTED
+  // avec CN_MISMATCH dans cette bissection.
+  int ret = mbedtls_x509_crt_verify(crt, trust, nullptr, nullptr, &flags, nullptr, nullptr);
+  char infoBuf[220] = {0};
+  if (flags != 0) {
+    mbedtls_x509_crt_verify_info(infoBuf, sizeof(infoBuf), "  ! ", flags);
+  }
+  systemLogger.error(String("[bug-165] Bissection — ") + label + " : ret=" + String(ret) +
+                     " flags=0x" + String(flags, HEX) + " detail=[" + String(infoBuf) + "]");
+}
