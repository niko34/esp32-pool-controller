+}
+
+// bug-165 (dernière piste) : journaliser le profil de vérification RÉELLEMENT
+// configuré par la connexion live (lu, pas supposé), puis rejouer la
+// bissection hors ligne avec la fonction et les paramètres EXACTS du chemin
+// TLS réel : mbedtls_x509_crt_verify_with_profile(), ce profil, et le nom
+// d'hôte "api.github.com" (l'offline précédent utilisait verify() + cn=null).
+static void logMbedtlsRealProfileAndReverify(const mbedtls_x509_crt_profile* profile) {
+  if (profile == nullptr) {
+    systemLogger.error("[bug-165] Profil de vérification introuvable (ssl_conf non configuré)");
+    return;
+  }
+
+  systemLogger.info(
+    String("[bug-165] Profil REEL (lu sur la connexion live) — allowed_mds=0x") + String(profile->allowed_mds, HEX) +
+    " allowed_pks=0x" + String(profile->allowed_pks, HEX) +
+    " allowed_curves=0x" + String(profile->allowed_curves, HEX) +
+    " rsa_min_bitlen=" + String(profile->rsa_min_bitlen));
+
+  // Identifier le profil connu correspondant (comparaison d'ADRESSE, pas de
+  // contenu — ce sont des tables const globales du binaire).
+  const char* knownName = "INCONNU (ni default, ni suiteb, ni none)";
+  if (profile == &mbedtls_x509_crt_profile_default) {
+    knownName = "mbedtls_x509_crt_profile_default";
+  } else if (profile == &mbedtls_x509_crt_profile_suiteb) {
+    knownName = "mbedtls_x509_crt_profile_suiteb";
+  } else if (profile == &mbedtls_x509_crt_profile_none) {
+    knownName = "mbedtls_x509_crt_profile_none";
+  }
+  systemLogger.info(String("[bug-165] Profil identifie par adresse: ") + knownName);
+
+  // Courbes nommément autorisées par ce profil, et verdict secp384r1 EXPLICITE.
+  String allowedCurveNames = "";
+  bool profileAllowsSecp384r1 = (profile->allowed_curves & MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_SECP384R1)) != 0;
+  const mbedtls_ecp_curve_info* info = mbedtls_ecp_curve_list();
+  for (; info != nullptr && info->grp_id != MBEDTLS_ECP_DP_NONE; info++) {
+    if (profile->allowed_curves & MBEDTLS_X509_ID_FLAG(info->grp_id)) {
+      allowedCurveNames += String(info->name) + " ";
+    }
+  }
+  systemLogger.info("[bug-165] Courbes AUTORISEES par ce profil: " + allowedCurveNames);
+  systemLogger.info(String("[bug-165] Ce profil autorise secp384r1 (P-384): ") +
+                    (profileAllowsSecp384r1 ? "OUI" : "NON — C'EST POTENTIELLEMENT LA CAUSE"));
+
+  // Rejoue la bissection hors ligne À L'IDENTIQUE du chemin réel : fonction
+  // _with_profile(), CE profil exact, et cn="api.github.com" (pas nullptr).
+  mbedtls_x509_crt trust;
+  mbedtls_x509_crt_init(&trust);
+  int trustRet = mbedtls_x509_crt_parse(&trust, (const unsigned char*)GITHUB_ROOT_CA, strlen(GITHUB_ROOT_CA) + 1);
+  if (trustRet < 0) {
+    systemLogger.error("[bug-165] Echec parsing GITHUB_ROOT_CA pour re-verif profil reel (code=" + String(trustRet) + ")");
+    mbedtls_x509_crt_free(&trust);
+    return;
+  }
+
+  mbedtls_x509_crt chain;
+  mbedtls_x509_crt_init(&chain);
+  mbedtls_x509_crt_parse(&chain, (const unsigned char*)kBug165Leaf, strlen(kBug165Leaf) + 1);
+  mbedtls_x509_crt_parse(&chain, (const unsigned char*)kBug165E36, strlen(kBug165E36) + 1);
+  mbedtls_x509_crt_parse(&chain, (const unsigned char*)kBug165E46Crossed, strlen(kBug165E46Crossed) + 1);
+
+  uint32_t flags = 0;
+  int ret = mbedtls_x509_crt_verify_with_profile(&chain, &trust, nullptr, profile, "api.github.com",
+                                                 &flags, nullptr, nullptr);
+  char infoBuf[220] = {0};
+  if (flags != 0) {
+    mbedtls_x509_crt_verify_info(infoBuf, sizeof(infoBuf), "  ! ", flags);
+  }
+  systemLogger.error(
+    String("[bug-165] Re-verif IDENTIQUE au chemin reel (verify_with_profile + profil reel + cn=api.github.com): ") +
+    "ret=" + String(ret) + " flags=0x" + String(flags, HEX) + " detail=[" + String(infoBuf) + "]");
+
+  mbedtls_x509_crt_free(&chain);
+  mbedtls_x509_crt_free(&trust);
+}
 
