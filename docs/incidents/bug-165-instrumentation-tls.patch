+// bug-165 (suite) : trancher l'hypothèse ECDSA P-384/SHA-384. Observation pure,
+// exécutée à la demande (une fois par /check-update), aucune allocation
+// durable — uniquement des buffers de pile et une String locale au parsing.
+static void logMbedtlsTlsCapabilityDiagnostics() {
+  systemLogger.info(String("[bug-165] mbedtls version: ") + MBEDTLS_VERSION_STRING);
+
+  // 1. Courbes elliptiques RÉELLEMENT supportées par le binaire précompilé à
+  // l'exécution — le sdkconfig du paquet pioarduino n'est qu'une déclaration
+  // de build, pas une preuve du binaire livré.
+  String curves = "";
+  bool hasSecp384r1 = false;
+  const mbedtls_ecp_curve_info* info = mbedtls_ecp_curve_list();
+  for (; info != nullptr && info->grp_id != MBEDTLS_ECP_DP_NONE; info++) {
+    curves += String(info->name) + "(id=" + String((int)info->grp_id) + ") ";
+    if (info->grp_id == MBEDTLS_ECP_DP_SECP384R1) {
+      hasSecp384r1 = true;
+    }
+  }
+  systemLogger.info("[bug-165] Courbes EC supportees a l'execution: " + curves);
+  systemLogger.info(String("[bug-165] secp384r1 (P-384) presente: ") + (hasSecp384r1 ? "OUI" : "NON"));
+
+  // 2. Auto-vérification de l'ancre Sectigo Root E46 (ECC P-384, auto-signée)
+  // CONTRE ELLE-MÊME : même opération cryptographique (parse + vérif de
+  // signature ECDSA/SHA-384) que celle exercée par le handshake réel, mais
+  // isolée du réseau — si elle échoue ICI, la pile crypto locale est en cause,
+  // pas la chaîne reçue de GitHub.
+  mbedtls_x509_crt chain;
+  mbedtls_x509_crt_init(&chain);
+  int parseRet = mbedtls_x509_crt_parse(&chain, (const unsigned char*)GITHUB_ROOT_CA, strlen(GITHUB_ROOT_CA) + 1);
+  if (parseRet < 0) {
+    systemLogger.error("[bug-165] Echec parsing GITHUB_ROOT_CA pour auto-test (code=" + String(parseRet) + ")");
+  } else {
+    mbedtls_x509_crt* e46 = &chain;
+    char dnBuf[150];
+    bool found = false;
+    while (e46 != nullptr) {
+      mbedtls_x509_dn_gets(dnBuf, sizeof(dnBuf), &e46->subject);
+      if (strstr(dnBuf, "E46") != nullptr) {
+        found = true;
+        break;
+      }
+      e46 = e46->next;
+    }
+    if (!found) {
+      systemLogger.error("[bug-165] Ancre E46 introuvable dans GITHUB_ROOT_CA pour l'auto-test");
+    } else {
+      // Isoler ce seul maillon (couper ->next) pour que trust_ca==crt ne
+      // vérifie QUE E46 contre lui-même, sans entraîner les 4 autres ancres.
+      mbedtls_x509_crt* savedNext = e46->next;
+      e46->next = nullptr;
+      uint32_t selfFlags = 0;
+      int vret = mbedtls_x509_crt_verify(e46, e46, nullptr, nullptr, &selfFlags, nullptr, nullptr);
+      e46->next = savedNext;
+      char infoBuf[200] = {0};
+      if (selfFlags != 0) {
+        mbedtls_x509_crt_verify_info(infoBuf, sizeof(infoBuf), "  ! ", selfFlags);
+      }
+      systemLogger.info("[bug-165] Auto-verif Root E46 (P-384) contre elle-meme: ret=" + String(vret) +
+                        " flags=0x" + String(selfFlags, HEX) + " detail=[" + String(infoBuf) + "]");
+    }
+  }
+  mbedtls_x509_crt_free(&chain);
+}
